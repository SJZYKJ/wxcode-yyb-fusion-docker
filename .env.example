# ==========================================
# YYB Go 融合网关 (yyb-go + wxcode) - 纯 Docker 环境变量
# 复制为 .env 后按需修改
# ==========================================

# ---- 镜像与数据目录 ----
# 默认直接拉取预构建镜像；改了源码想本地构建请用 compose.build.yaml
IMAGE_REPO=chungg/wxcode-yyb-fusion
# 固定版本便于回滚，例如 sha-9f3c1a2 或 SHA-0917-V1.0
IMAGE_TAG=latest
# 数据目录（SQLite / 头像 / 二维码），相对路径以 compose 文件所在目录为基准
DATA_DIR=./data

# 网关监听
YYB_BIND_ADDRESS=0.0.0.0
YYB_PORT=8088
YYB_PLATFORM=linux/amd64

# ---- 访问令牌（重要）----
# 留空 = /login、/instances、/wxapp/*、/wx/* 等取码接口不做鉴权，行为与旧版本一致。
# 一旦填写，脚本/自动化调用这些接口必须带上令牌，三种方式任选：
#     Authorization: Bearer <你的令牌>
#     X-API-Token: <你的令牌>
#     ?token=<你的令牌>
# 浏览器登录控制台不受影响（会话本身即凭据），/health 与 /wxcode/* 也始终开放。
# 生成一个随机令牌：openssl rand -hex 24
YYB_API_TOKEN=

# ---- 可选取码端点（默认关闭）----
# 原生微信扫码登录无需任何配置（浏览器打开 /scan 即可）。
# 若手机已 root 并安装 wxcode_2.1.0.apk，可把它作为设备取码端点：
#   WXCODE_URLS=http://<手机IP>:8088
# 多设备用逗号分隔：http://ip1:8088,http://ip2:8088
# wxcode 设备协议端口（与 /wxcode/hookcfg 输出一致，默认 8088）
WXCODE_URLS=
WXCODE_HOOK_PORT=8088

# Web 鉴权（SQLite，首个注册账号为管理员）
YYB_AUTH_DRIVER=sqlite
YYB_AUTH_DSN=
YYB_ADMIN_USER=admin
YYB_ADMIN_PASSWORD=

# 面板（qinglong / daidai）
PANEL_TYPE=qinglong
QL_URL=
QL_CLIENT_ID=
QL_CLIENT_SECRET=
DAIDAI_URL=
DAIDAI_APP_KEY=
DAIDAI_APP_SECRET=

# 青龙回调
YYB_QINGLONG_SERVER=
YYB_QINGLONG_REPO=

# DNS
YYB_DNS_SERVERS=223.5.5.5:53,119.29.29.29:53

# 保活
YYB_KEEPALIVE_INTERVAL=30m
YYB_KEEPALIVE_AHEAD=45m

# HTTPS 反代时设 true
YYB_COOKIE_SECURE=false

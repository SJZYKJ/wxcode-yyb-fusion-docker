# ==========================================
# wxcode-YYB 网关 - 纯 Docker 环境变量
# 复制为 .env 后按需修改
# ==========================================

# ---- 镜像与数据目录 ----
# 默认直接拉取预构建镜像；改了源码想本地构建请用 compose.build.yaml
IMAGE_REPO=chungg/wxcode-yyb-fusion
# 固定版本便于回滚：填正式发布号 v<N>，例如 v4（全局递增的整数，永不重置）。
# latest 会跟着最新构建动，不要用它做回滚。
IMAGE_TAG=latest
# 数据目录（SQLite / 头像 / 二维码），相对路径以 compose 文件所在目录为基准
DATA_DIR=./data

# 网关监听
YYB_BIND_ADDRESS=0.0.0.0
YYB_PORT=8088
YYB_PLATFORM=linux/amd64

# ---- 访问令牌（重要）----
# 取码接口默认【必须鉴权】（fail-closed）：/login 取码分支、/instances、
# /wxapp/*、/wx/*、/openapi.json。脚本/自动化调用这些接口必须带令牌，
# 三种方式任选：
#     Authorization: Bearer <你的令牌>
#     X-API-Token: <你的令牌>
#     ?token=<你的令牌>
# 浏览器登录控制台不受影响（会话本身即凭据），/health 与 /static 始终开放。
# 生成一个随机令牌：openssl rand -hex 24
# 留空也不会裸奔：网关首次启动会自动生成令牌、存进数据库（跟随数据卷持久化、
# 重启不变）并打印到 docker logs，日志里搜「已自动生成 API 访问令牌」。
YYB_API_TOKEN=

# 想真正关闭取码接口鉴权（⚠️ 端口可达即可列出全部 openid 并取码），
# 必须显式设为 true。仅建议在完全可信的内网、或前面已有强鉴权反代时使用。
YYB_ALLOW_NO_AUTH=false

# ---- Web 控制台注册与代理 ----
# 公开注册默认【关闭】。关闭时：库中没有任何账号的情况下，仅允许「内网/回环
# 地址」完成首次注册（第一个账号自动成为管理员），公网来源一律拒绝，避免实例
# 刚暴露就被陌生人抢注管理员。想允许任何人注册（风险自负）设为 true。
YYB_ALLOW_REGISTRATION=false

# 只有确实部署在反向代理（Nginx/NPM 等）后面时才设为 true：
# 开启后登录限速等会以 X-Forwarded-For 为准；直连暴露时必须保持 false，
# 否则攻击者可以伪造该请求头绕过登录失败计数。
YYB_TRUST_PROXY=false

# 原生微信扫码登录无需任何配置（浏览器打开 /scan 即可）。

# Web 鉴权（SQLite）。注册默认关闭（还要配 SMTP 才能收验证码）。
# 首个管理员账号在用户库为空时自动创建：
#   - YYB_ADMIN_PASSWORD 留空 → 启动时随机生成 16 位密码并打印到容器日志
#     docker logs <容器名> 2>&1 | grep 管理员
#   - 想固定就填 ≥10 位密码（例如下面注释掉的那种写法）：
#   YYB_ADMIN_USER=admin
#   YYB_ADMIN_PASSWORD=<10 位以上>
YYB_AUTH_DRIVER=sqlite
YYB_AUTH_DSN=
YYB_ADMIN_USER=admin
YYB_ADMIN_PASSWORD=

# 面板（qinglong / daidai）
PANEL_TYPE=qinglong
QL_URL=
QL_CLIENT_ID=
QL_CLIENT_SECRET=
DAIDAI_URL=
DAIDAI_APP_KEY=
DAIDAI_APP_SECRET=

# 青龙回调
# YYB_QINGLONG_SERVER：只写 <host>:<port>。网关会把它塞进每个账号任务的 task_before 里的
#   YYB_SERVER 环境变量，脚本靠它回连网关取码。
YYB_QINGLONG_SERVER=

# DNS
YYB_DNS_SERVERS=223.5.5.5:53,119.29.29.29:53

# 保活
YYB_KEEPALIVE_INTERVAL=30m
YYB_KEEPALIVE_AHEAD=45m

# HTTPS 反代时设 true
YYB_COOKIE_SECURE=false

# 时区（容器内日志/维护窗口按它显示；镜像已内置 tzdata）
TZ=Asia/Shanghai

# ---- 注册邮箱验证码 ----
# 想开「邮箱+验证码注册」就填这组 SMTP；留空则注册被明确拒绝并提示联系管理员。
# 465 端口用隐式 TLS（YYB_SMTP_TLS=true）；587 端口用 STARTTLS（设 false）。
# 也可以在控制台「设置 → 邮件服务」里配置，界面配置优先于环境变量。
YYB_SMTP_HOST=
YYB_SMTP_PORT=
YYB_SMTP_USERNAME=
YYB_SMTP_PASSWORD=
YYB_SMTP_FROM=
YYB_SMTP_TLS=true

# ---- 可选高级开关（全部可选，留空用默认值）----
# 协议路由令牌：与 YYB_API_TOKEN 是两道独立闸门，留空=不启用这一层。
YYB_PROTOCOL_TOKEN=
# 集成接口（/integration/*）令牌，控制面调用时用。
YYB_INTEGRATION_TOKEN=
# 同步到面板的账号引用方式：id（默认）或 openid。
YYB_QINGLONG_REF_MODE=id
# 青龙脚本仓库地址（运行管理按脚本目录建任务时用）
YYB_QINGLONG_REPO=
# 桌面微信快速授权（实验特性，默认关）。Docker 里没有本机微信，保持 false。
YYB_ENABLE_PC_LOGIN=false
# 协议设备标识：stable（每个账号固定设备，推荐）/ random（旧行为）
YYB_DEVICE_IDENTITY=stable
# 应用宝刷新策略：legacy_auth（默认）/ source
YYB_APPSTORE_REFRESH_MODE=legacy_auth

# 掉线通知：serverchan / pushplus / qywx，留空关闭
YYB_NOTIFY_CHANNEL=
YYB_NOTIFY_TOKEN=
YYB_NOTIFY_TOPIC=
YYB_NOTIFY_ACCOUNT_PUSH=true

# 防封：取码熔断与限速（默认开启，不建议关）
YYB_CIRCUIT_BREAKER=on
YYB_CODE_MIN_GAP=3s
YYB_CODE_MAX_WAIT=20s
YYB_LOGIN_BUDGET=3
YYB_LOGIN_WINDOW=10m
# AppID 防护：额外拒绝/放行的 AppID（逗号分隔），留空用内置网站应用名单
YYB_CODE_DENY_APPIDS=
YYB_CODE_ALLOW_APPIDS=

# 版本检查（可选）

# wxcode + YYB Go 融合版运行时配置。
# wxcode（Xposed 模块）独立监听本机 8088 端口提供 wx.login 取码能力，
# 与 yyb-go 的 /wx/*、/wxapp/* 接口互补；无需在此配置 wxcode。
# 本文件只配置 yyb-go。默认 HOST=127.0.0.1 仅本机可访问。
# 注意：本配置被 service.sh 以 shell 语法 source，值含空格或 # & 等字符需加引号。
# YYB Go Magisk runtime configuration.
# Quote values that contain spaces, &, #, or other shell characters.

HOST=127.0.0.1
PORT=8000
KEEPALIVE_INTERVAL=30m
KEEPALIVE_AHEAD=45m
TCP_PROXY=

# wxcode 设备直取源（Xposed 模块，本机 8088）。逗号分隔可配多台设备，
# 例如 WXCODE_URLS=http://127.0.0.1:8088,http://192.168.1.21:8088
# yyb-go 的 /wxapp/deviceCode、/wx/devicecode 会按顺序尝试这些地址。
WXCODE_URLS=http://127.0.0.1:8088

# Static Android builds may not be able to use netd's loopback DNS stub.
# Leave this default in place if logs mention [::1]:53 connection refused.
YYB_DNS_SERVERS=223.5.5.5:53,119.29.29.29:53

# Optional QingLong or daidai-panel integration. When panel scripts must call
# this phone, set HOST=0.0.0.0 and YYB_QINGLONG_SERVER=phone-lan-ip:8000.
# Reserve the phone address in the router; never expose port 8000 publicly.
PANEL_TYPE=qinglong
QL_URL=
QL_CLIENT_ID=
QL_CLIENT_SECRET=
DAIDAI_URL=
DAIDAI_APP_KEY=
DAIDAI_APP_SECRET=
YYB_QINGLONG_SERVER=

# Browser authentication defaults to a local SQLite database. The first
# registered account becomes administrator when no initial password is set.
YYB_AUTH_DRIVER=sqlite
YYB_AUTH_DSN=
YYB_AUTH_MYSQL_DSN=
YYB_ADMIN_USER=admin
YYB_ADMIN_PASSWORD=
YYB_COOKIE_SECURE=false

# ==========================================
# wxcode + YYB Go 融合版 Docker 环境变量
# 复制为 .env 后按需修改
# ==========================================

# 手机端取码源地址（必改！）
# - 手机装 wxcode_2.1.0.apk (Xposed/LSPosed): 填 http://手机IP:8088
# - 手机用 Zygisk 融合模块: 填 http://手机IP:8089
# 多台设备逗号分隔: http://192.168.1.100:8088,http://192.168.1.101:8088
WXCODE_URLS=http://192.168.1.100:8088
WXCODE_HOOK_PORT=8088

# 网关绑定与端口
YYB_BIND_ADDRESS=0.0.0.0
YYB_PORT=8088

# Web 鉴权 (SQLite, 首次注册账号为管理员)
YYB_AUTH_DRIVER=sqlite
YYB_AUTH_DSN=
YYB_ADMIN_USER=admin
YYB_ADMIN_PASSWORD=

# 面板 (qinglong / daidai)
PANEL_TYPE=qinglong
QL_URL=
QL_CLIENT_ID=
QL_CLIENT_SECRET=
DAIDAI_URL=
DAIDAI_APP_KEY=
DAIDAI_APP_SECRET=

# 青龙回调地址
YYB_QINGLONG_SERVER=
YYB_QINGLONG_REPO=

# DNS
YYB_DNS_SERVERS=223.5.5.5:53,119.29.29.29:53

# 保活
YYB_KEEPALIVE_INTERVAL=30m
YYB_KEEPALIVE_AHEAD=45m

# HTTPS 反代时设 true
YYB_COOKIE_SECURE=false
